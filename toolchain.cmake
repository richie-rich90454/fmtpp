# fmtpp cross-compilation toolchain (zig cc)
# Usage: cmake -B build -DCMAKE_TOOLCHAIN_FILE=toolchain.cmake [-DTARGET=linux-x64]
# Supported TARGET values: linux-x64, linux-arm64, macos-x64, macos-arm64, windows-x64

# Detect host platform if TARGET not specified
if(NOT DEFINED TARGET)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(TARGET "windows-x64")
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
      set(TARGET "macos-arm64")
    else()
      set(TARGET "macos-x64")
    endif()
  else()
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
      set(TARGET "linux-arm64")
    else()
      set(TARGET "linux-x64")
    endif()
  endif()
  message(STATUS "fmtpp toolchain: auto-detected target ${TARGET}")
endif()

# Map target names to zig triple and system
if(TARGET STREQUAL "linux-x64")
  set(ZIG_TARGET "x86_64-linux-gnu")
  set(CMAKE_SYSTEM_NAME Linux)
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
elseif(TARGET STREQUAL "linux-arm64")
  set(ZIG_TARGET "aarch64-linux-gnu")
  set(CMAKE_SYSTEM_NAME Linux)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
elseif(TARGET STREQUAL "macos-x64")
  set(ZIG_TARGET "x86_64-macos-none")
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
elseif(TARGET STREQUAL "macos-arm64")
  set(ZIG_TARGET "aarch64-macos-none")
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
elseif(TARGET STREQUAL "windows-x64")
  set(ZIG_TARGET "x86_64-windows-gnu")
  set(CMAKE_SYSTEM_NAME Windows)
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
else()
  message(FATAL_ERROR "Unknown TARGET '${TARGET}'. Supported: linux-x64, linux-arm64, macos-x64, macos-arm64, windows-x64")
endif()

# Compiler setup
set(CMAKE_C_COMPILER zig)
set(CMAKE_CXX_COMPILER zig)
set(CMAKE_C_COMPILER_ARG1 "cc;-target;${ZIG_TARGET}")
set(CMAKE_CXX_COMPILER_ARG1 "c++;-target;${ZIG_TARGET}")

set(CMAKE_C_COMPILER_TARGET ${ZIG_TARGET})
set(CMAKE_CXX_COMPILER_TARGET ${ZIG_TARGET})

# Static library for try_compile (cross-compilation can't run executables)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)